rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Dados pessoais: só o dono lê e escreve.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Baralhos compartilhados: o código de convite é o id do baralho.
    match /sharedDecks/{deckId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      // no mapa de nomes, cada pessoa só mexe no próprio nome
      function onlyMyName() {
        return after().get('names', {}).diff(before().get('names', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      function okColor() {
        return !('color' in after()) || (after().color is string && after().color.matches('^#[0-9A-Fa-f]{3,8}$'));
      }

      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && after().owner == request.auth.uid
        && after().members == [request.auth.uid]
        && okColor();
      allow update: if signedIn() && after().owner == before().owner && okColor() && onlyMyName() && (
        // Membro: renomeia o baralho ou sai dele. Não coloca nem tira outras pessoas.
        (request.auth.uid in before().members
          && (after().members.toSet() == before().members.toSet()
            || (after().members.toSet() == before().members.toSet().difference([request.auth.uid].toSet())
              && request.auth.uid != before().owner)))
        // Quem tem o código: só se inclui.
        || (!(request.auth.uid in before().members)
          && after().diff(before()).affectedKeys().hasOnly(['members', 'names'])
          && after().members.toSet() == before().members.toSet().union([request.auth.uid].toSet()))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /cards/{cardId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sharedDecks/$(deckId)).data.members;
      }
    }
  }
}
