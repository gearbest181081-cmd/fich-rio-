rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Dados pessoais: só o dono lê e escreve.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Baralhos compartilhados: o código de convite é o id do baralho.
    match /sharedDecks/{deckId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Membros podem editar; quem tem o código pode só se incluir.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.owner == resource.data.owner)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /cards/{cardId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sharedDecks/$(deckId)).data.members;
      }
    }
  }
}
